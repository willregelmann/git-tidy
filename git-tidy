#!/bin/bash
# git-tidy — Delete local branches fully merged into the default branch.
# Place on PATH (or symlink) to use as: git tidy

set -euo pipefail

dry_run=false
delete_remote=false
skip_confirm=false
base_branch=""
remote="origin"
exclude_patterns=()

# Expand combined short flags (e.g. -rn -> -r -n)
expanded=()
for arg in "$@"; do
    if [[ "$arg" =~ ^-[a-zA-Z]{2,}$ ]]; then
        for (( i=1; i<${#arg}; i++ )); do
            expanded+=("-${arg:$i:1}")
        done
    else
        expanded+=("$arg")
    fi
done

i=0
while [[ $i -lt ${#expanded[@]} ]]; do
    arg="${expanded[$i]}"
    case "$arg" in
        -n|--dry-run) dry_run=true ;;
        -r|--remote) delete_remote=true ;;
        -y|--yes) skip_confirm=true ;;
        -e|--exclude)
            i=$((i + 1))
            if [[ $i -ge ${#expanded[@]} ]]; then
                echo "Option $arg requires a pattern" >&2
                exit 1
            fi
            exclude_patterns+=("${expanded[$i]}")
            ;;
        --exclude=*)
            exclude_patterns+=("${arg#--exclude=}")
            ;;
        -b|--base)
            i=$((i + 1))
            if [[ $i -ge ${#expanded[@]} ]]; then
                echo "Option $arg requires a branch name" >&2
                exit 1
            fi
            base_branch="${expanded[$i]}"
            ;;
        --base=*)
            base_branch="${arg#--base=}"
            ;;
        --remote-name)
            i=$((i + 1))
            if [[ $i -ge ${#expanded[@]} ]]; then
                echo "Option $arg requires a remote name" >&2
                exit 1
            fi
            remote="${expanded[$i]}"
            ;;
        --remote-name=*)
            remote="${arg#--remote-name=}"
            ;;
        -h|--help)
            echo "Usage: git tidy [-n|--dry-run] [-r|--remote] [-y|--yes] [-b|--base <branch>] [-e|--exclude <pattern>] [--remote-name <name>]"
            echo ""
            echo "Delete local branches fully merged into the default branch."
            echo ""
            echo "Options:"
            echo "  -n, --dry-run            Show which branches would be deleted without deleting them"
            echo "  -r, --remote             Delete merged branches from the remote instead of local"
            echo "  -y, --yes                Skip confirmation prompt"
            echo "  -b, --base <branch>      Branch to compare against (default: auto-detected from remote)"
            echo "  -e, --exclude <pattern>  Exclude branches matching glob pattern (repeatable)"
            echo "      --remote-name <name> Remote to compare against (default: origin)"
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            exit 1
            ;;
    esac
    i=$((i + 1))
done

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "Not inside a git repository." >&2
    exit 1
fi

if ! git remote get-url "$remote" &>/dev/null; then
    echo "Remote '$remote' not found." >&2
    exit 1
fi

# Detect default branch if not specified
if [[ -n "$base_branch" ]]; then
    default_branch="$base_branch"
else
    default_branch=$(git symbolic-ref "refs/remotes/${remote}/HEAD" 2>/dev/null | sed "s@^refs/remotes/${remote}/@@") || true
    if [[ -z "$default_branch" ]]; then
        if git show-ref --verify --quiet "refs/remotes/${remote}/main"; then
            default_branch="main"
        elif git show-ref --verify --quiet "refs/remotes/${remote}/master"; then
            default_branch="master"
        else
            echo "Could not determine default branch." >&2
            exit 1
        fi
    fi
fi

is_excluded() {
    local branch="$1"
    for pattern in "${exclude_patterns[@]}"; do
        # shellcheck disable=SC2254
        case "$branch" in $pattern) return 0 ;; esac
    done
    return 1
}

# Emit a transient progress line only to an interactive terminal, so piped or
# redirected output stays free of ANSI escape codes.
progress() {
    [[ -t 1 ]] || return 0
    printf '\r\033[K%s' "$1"
}

# Classify how a ref relates to the base branch. Echoes:
#   "ancestor" — no commits beyond the base (plain or fast-forward merge);
#                safe to delete with `git branch -d`.
#   "patch"    — the ref's changes are already upstream via a squash or rebase
#                merge, so its commits differ by SHA; requires `git branch -D`.
#   ""         — not merged.
merge_status() {
    local ref="$1"
    local base="${remote}/${default_branch}"
    local ahead
    ahead=$(git rev-list --count "$base..$ref" 2>/dev/null) || return 0
    if [[ "$ahead" == "0" ]]; then
        echo "ancestor"
        return 0
    fi
    # Rebase / cherry-pick merge: every commit has a patch-equivalent upstream,
    # so `git cherry` marks them all with "-" (none with "+").
    local cherry_out
    cherry_out=$(git cherry "$base" "$ref" 2>/dev/null) || return 0
    if ! grep -q '^+' <<<"$cherry_out"; then
        echo "patch"
        return 0
    fi
    # Squash merge: collapse the ref's cumulative diff into one synthetic commit
    # off the merge base, then check whether that diff is already upstream.
    local mb tree dangling
    mb=$(git merge-base "$base" "$ref" 2>/dev/null) || return 0
    tree=$(git rev-parse "$ref^{tree}" 2>/dev/null) || return 0
    dangling=$(git commit-tree "$tree" -p "$mb" -m _ 2>/dev/null) || return 0
    if git cherry "$base" "$dangling" 2>/dev/null | grep -q '^-'; then
        echo "patch"
    fi
    return 0
}

git fetch "$remote" --prune --quiet || true

current=$(git branch --show-current)
candidates=()
methods=()

# Collect candidates
if $delete_remote; then
    for ref in $(git for-each-ref --format='%(refname)' "refs/remotes/${remote}/"); do
        # Skip the <remote>/HEAD symref (its short name is the remote name itself)
        [[ "$ref" == "refs/remotes/${remote}/HEAD" ]] && continue
        branch="${ref#refs/remotes/"${remote}"/}"
        [[ "$branch" == "$default_branch" ]] && continue
        [[ ${#exclude_patterns[@]} -gt 0 ]] && is_excluded "$branch" && continue

        status=$(merge_status "$ref")
        [[ -n "$status" ]] && { candidates+=("$branch"); methods+=("$status"); }
    done
else
    for branch in $(git for-each-ref --format='%(refname:short)' refs/heads/); do
        [[ "$branch" == "$current" ]] && continue
        [[ "$branch" == "$default_branch" ]] && continue
        [[ ${#exclude_patterns[@]} -gt 0 ]] && is_excluded "$branch" && continue

        status=$(merge_status "$branch")
        [[ -n "$status" ]] && { candidates+=("$branch"); methods+=("$status"); }
    done
fi

if [[ ${#candidates[@]} -eq 0 ]]; then
    echo "No merged branches to clean up."
    exit 0
fi

# Dry run — just print and exit
if $dry_run; then
    echo "Would delete ${#candidates[@]} merged branch(es):"
    printf '  %s\n' "${candidates[@]}"
    exit 0
fi

# Confirm unless --force
if ! $skip_confirm; then
    echo "Will delete ${#candidates[@]} merged branch(es):"
    printf '  %s\n' "${candidates[@]}"
    printf "Proceed? [y/N] "
    # `|| true` so a closed stdin (EOF) aborts cleanly rather than tripping set -e.
    read -r answer || true
    case "$answer" in
        [yY]|[yY][eE][sS]) ;;
        *) echo "Aborted."; exit 0 ;;
    esac
fi

# Delete
total=${#candidates[@]}
deleted=()
failed=()
if $delete_remote; then
    for idx in "${!candidates[@]}"; do
        branch="${candidates[$idx]}"
        progress "[$((idx + 1))/$total] Deleting ${remote}/${branch}..."
        if git push "$remote" --delete "$branch" &>/dev/null; then
            deleted+=("$branch")
        else
            failed+=("$branch")
        fi
    done
else
    for idx in "${!candidates[@]}"; do
        branch="${candidates[$idx]}"
        progress "[$((idx + 1))/$total] Deleting ${branch}..."
        # Squash/rebase-merged branches differ by SHA, so `git branch -d` would
        # refuse them; we already verified their changes are upstream, so force.
        if [[ "${methods[$idx]}" == "ancestor" ]]; then
            delete_flag="-d"
        else
            delete_flag="-D"
        fi
        if git branch "$delete_flag" "$branch" &>/dev/null; then
            deleted+=("$branch")
        else
            failed+=("$branch")
        fi
    done
fi
progress ""

if [[ ${#deleted[@]} -gt 0 ]]; then
    echo "Deleted ${#deleted[@]} merged branch(es):"
    printf '  %s\n' "${deleted[@]}"
else
    echo "No branches were deleted."
fi
if [[ ${#failed[@]} -gt 0 ]]; then
    echo "Failed to delete ${#failed[@]} branch(es):"
    printf '  %s\n' "${failed[@]}"
fi
